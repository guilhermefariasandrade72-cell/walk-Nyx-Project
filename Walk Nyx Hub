local FloatingDragging = false

local FloatingDragStart = nil
local FloatingStartPosition = nil

local FloatingMovedDistance = 0
local FloatingActiveInput = nil

local FLOAT_DRAG_THRESHOLD = 8

--==============================================================--
--                 CLAMP FLOATING BUTTON                        --
--==============================================================--

local function ClampFloatingButton(Position)

    local Camera =
        workspace.CurrentCamera

    if not Camera then
        return Position
    end

    local Viewport =
        Camera.ViewportSize

    local ButtonWidth =
        FloatingButton.AbsoluteSize.X

    local ButtonHeight =
        FloatingButton.AbsoluteSize.Y

    local HalfWidth =
        ButtonWidth / 2

    local HalfHeight =
        ButtonHeight / 2

    local X =
        math.clamp(
            Position.X,
            HalfWidth,
            math.max(
                HalfWidth,
                Viewport.X - HalfWidth
            )
        )

    local Y =
        math.clamp(
            Position.Y,
            HalfHeight,
            math.max(
                HalfHeight,
                Viewport.Y - HalfHeight
            )
        )

    return Vector2.new(
        X,
        Y
    )
end

--==============================================================--
--              UPDATE FLOATING BUTTON SIZE                    --
--==============================================================--

local function SetFloatingButtonSize(Size)

    local NewSize =
        math.clamp(
            math.floor(Size + 0.5),
            MIN_FLOATING_SIZE,
            MAX_FLOATING_SIZE
        )

    FloatingButtonSize =
        NewSize

    -- IMPORTANT:
    -- Do not modify Position here.
    -- The button uses AnchorPoint 0.5 / 0.5,
    -- so Roblox keeps its center fixed automatically.

    FloatingButton.Size =
        UDim2.fromOffset(
            NewSize,
            NewSize
        )
end

