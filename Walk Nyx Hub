-- ==================================
-- 📦 VARIÁVEIS — MOVEMENT PLAYER
-- ==================================
local SpeedAtivo = false
local SpeedValor = 16
local SpeedOriginal = 16

local JumpPowerAtivo = false
local JumpPowerValor = 50
local JumpPowerOriginal = 50


-- ———— // CRIANÇÃO DA ABA LOCAL PLAYER \\ ———— --
local Aba_LocalPlayer = Window:Tab({

    Title = "Local Player",

    Icon = "user-round",

})

-- ———— // BOTOES DA ABA LOCAL PLAYER \\ ———— --

-- ==================================
-- 📂 SEÇÃO: MOVEMENT PLAYER
-- ==================================
Aba_LocalPlayer:Section({
    Title = "Movement Player",
})

-- ==================================
-- ⚡ SPEED + SLIDER (16 a 45)
-- ==================================
Aba_LocalPlayer:Toggle({
    Title = "Speed",
    Default = false,
    Callback = function(state)
        SpeedAtivo = state
    end
})

Aba_LocalPlayer:Slider({
    Title = "Speed Value",
    Value = {
        Min = 16,
        Max = 45,
        Default = 16,
    },
    Step = 1,
    Callback = function(value)
        SpeedValor = value
    end
})

Aba_LocalPlayer:Toggle({
    Title = "Power Jump",
    Default = false,
    Callback = function(state)
        JumpPowerAtivo = state
    end
})

Aba_LocalPlayer:Slider({
    Title = "Jump Power",
    Value = {
        Min = 50,
        Max = 120,
        Default = 50,
    },
    Step = 5,
    Callback = function(value)
        JumpPowerValor = value
    end
})



-- ———— // SISTEMA DA ABA LOCAL PLAYER \\ ———— --

--   ==   / / / / / / / ———— \ \ \ \ \ \   ==    --


-- ==================================
-- ⚡ SISTEMA SPEED — CORRIGIDO
-- ==================================
RunService.Heartbeat:Connect(function()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if SpeedAtivo then
        hum.WalkSpeed = SpeedValor
    else
        hum.WalkSpeed = SpeedOriginal
    end
end)

-- ==================================
-- 🦘 SISTEMA POWER JUMP — CORRIGIDO
-- ==================================
RunService.Heartbeat:Connect(function()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if JumpPowerAtivo then
        hum.JumpPower = JumpPowerValor
    else
        hum.JumpPower = JumpPowerOriginal
    end
end)

-- Salva valores originais ao carregar
task.spawn(function()
    repeat task.wait(0.1) until player.Character
    local hum = player.Character:WaitForChild("Humanoid")
    SpeedOriginal = hum.WalkSpeed
    JumpPowerOriginal = hum.JumpPower
end)

-- ✅ RESETA AUTOMÁTICO AO RENASCER
player.CharacterAdded:Connect(function(novoChar)
    task.wait(0.2)
    local hum = novoChar:WaitForChild("Humanoid")
    SpeedOriginal = hum.WalkSpeed
    JumpPowerOriginal = hum.JumpPower
end)

