--==============================================================--
--                       WINDOW DRAG                            --
--==============================================================--

local Dragging = false
local DragStart = nil
local StartPosition = nil
local DragTouch = nil

local function ClampWindow()

    local Camera =
        workspace.CurrentCamera

    if not Camera then
        return
    end

    local Viewport =
        Camera.ViewportSize

    local Width =
        Window.AbsoluteSize.X

    local Height =
        Window.AbsoluteSize.Y

    local X =
        math.clamp(
            Window.Position.X.Offset,
            0,
            math.max(
                0,
                Viewport.X - Width
            )
        )

    local Y =
        math.clamp(
            Window.Position.Y.Offset,
            0,
            math.max(
                0,
                Viewport.Y - Height
            )
        )

    Window.Position =
        UDim2.fromOffset(
            X,
            Y
        )
end

local function UpdateWindowDrag(Point)

    if not Dragging then
        return
    end

    local Delta =
        Point - DragStart

    local Camera =
        workspace.CurrentCamera

    if not Camera then
        return
    end

    local Viewport =
        Camera.ViewportSize

    local Width =
        Window.AbsoluteSize.X

    local Height =
        Window.AbsoluteSize.Y

    local NewX =
        math.clamp(
            StartPosition.X.Offset + Delta.X,
            0,
            math.max(
                0,
                Viewport.X - Width
            )
        )

    local NewY =
        math.clamp(
            StartPosition.Y.Offset + Delta.Y,
            0,
            math.max(
                0,
                Viewport.Y - Height
            )
        )

    Window.Position =
        UDim2.fromOffset(
            NewX,
            NewY
        )
end

DragBar.InputBegan:Connect(function(Input)

    if Input.UserInputType ~=
        Enum.UserInputType.MouseButton1
    and Input.UserInputType ~=
        Enum.UserInputType.Touch then

        return
    end

    Dragging = true

    DragStart =
        Vector2.new(
            Input.Position.X,
            Input.Position.Y
        )

    StartPosition =
        Window.Position

    if Input.UserInputType ==
        Enum.UserInputType.Touch then

        DragTouch = Input

    else

        DragTouch = nil
    end

    Input.Changed:Connect(function()

        if Input.UserInputState ==
            Enum.UserInputState.End then

            Dragging = false
            DragTouch = nil

            ClampWindow()
        end
    end)
end)

UserInputService.InputChanged:Connect(function(Input)

    if not Dragging then
        return
    end

    if Input.UserInputType ==
        Enum.UserInputType.MouseMovement then

        UpdateWindowDrag(
            Vector2.new(
                Input.Position.X,
                Input.Position.Y
            )
        )
    end
end)

UserInputService.TouchMoved:Connect(function(Input)

    if not Dragging then
        return
    end

    if Input ~= DragTouch then
        return
    end

    UpdateWindowDrag(
        Vector2.new(
            Input.Position.X,
            Input.Position.Y
        )
    )
end)

