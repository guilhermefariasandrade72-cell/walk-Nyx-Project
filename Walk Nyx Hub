local function SetAccentColor(Name)

    local ColorData =
        AccentColors[Name]

    if not ColorData then
        return
    end

    CurrentAccentName =
        Name

    CurrentAccent =
        ColorData

    FloatingButton.TextColor3 =
        CurrentAccent.Bright

    FloatingStroke.Color =
        CurrentAccent.Bright

    LogoButton.TextColor3 =
        CurrentAccent.Bright

    LogoStroke.Color =
        CurrentAccent.Bright

    TopLine.BackgroundColor3 =
        CurrentAccent.Bright

    UpdateTopGradient()

    ConfirmTopLine.BackgroundColor3 =
        CurrentAccent.Bright

    ConfirmYes.BackgroundColor3 =
        CurrentAccent.Main

    ConfirmTopGradient.Color =
        ColorSequence.new({

            ColorSequenceKeypoint.new(
                0,
                Color3.fromRGB(0, 0, 0)
            ),

            ColorSequenceKeypoint.new(
                0.18,
                CurrentAccent.Main
            ),

            ColorSequenceKeypoint.new(
                0.50,
                CurrentAccent.Bright
            ),

            ColorSequenceKeypoint.new(
                0.82,
                CurrentAccent.Main
            ),

            ColorSequenceKeypoint.new(
                1,
                Color3.fromRGB(0, 0, 0)
            )
        })

    TabHolder.ScrollBarImageColor3 =
        CurrentAccent.Main

    for _, Page
        in pairs(Pages) do

        Page.ScrollBarImageColor3 =
            CurrentAccent.Main
    end

    for TabName, Data
        in pairs(TabButtons) do

        Data.Active.BackgroundColor3 =
            CurrentAccent.Bright

        if Data.Icon then

            pcall(function()

                if ActiveTab ==
                    TabName then

                    Data.Icon.ImageColor3 =
                        CurrentAccent.Bright

                else

                    Data.Icon.ImageColor3 =
                        Theme.Icon
                end

            end)
        end
    end

    ColorCurrent.Text =
        CurrentAccentName

    ColorCurrent.TextColor3 =
        CurrentAccent.Bright

    for ColorName, Data
        in pairs(ColorButtons) do

        if ColorName ==
            CurrentAccentName then

            Tween(
                Data.Check,
                {
                    TextTransparency = 0
                },
                0.12
            )

        else

            Tween(
                Data.Check,
                {
                    TextTransparency = 1
                },
                0.12
            )
        end

        Tween(
            Data.Dot,
