FloatingButton.InputBegan:Connect(function(Input)

    if Input.UserInputType ~=
        Enum.UserInputType.MouseButton1
    and Input.UserInputType ~=
        Enum.UserInputType.Touch then

        return
    end

    FloatingActiveInput =
        Input

    FloatingDragging = false
    FloatingMovedDistance = 0

    FloatingDragStart =
        Vector2.new(
            Input.Position.X,
            Input.Position.Y
        )

    local AbsolutePosition =
        FloatingButton.AbsolutePosition

    local AbsoluteSize =
        FloatingButton.AbsoluteSize

    FloatingStartPosition =
        Vector2.new(
            AbsolutePosition.X +
                AbsoluteSize.X / 2,

            AbsolutePosition.Y +
                AbsoluteSize.Y / 2
        )

    if not _G.WalkNyxFloatingLocked then

        Tween(
            FloatingScale,
            {
                Scale = 0.92
            },
            0.08
        )
    end
end)

--==============================================================--
--                    FLOATING MOUSE                            --
--==============================================================--

UserInputService.InputChanged:Connect(function(Input)

    if not FloatingActiveInput then
        return
    end

    if FloatingActiveInput.UserInputType ~=
        Enum.UserInputType.MouseButton1 then

        return
    end

    if Input.UserInputType ~=
        Enum.UserInputType.MouseMovement then

        return
    end

    if _G.WalkNyxFloatingLocked then
        return
    end

    local CurrentPosition =
        Vector2.new(
            Input.Position.X,
            Input.Position.Y
        )

    local Delta =
        CurrentPosition -
        FloatingDragStart

    FloatingMovedDistance =
        Delta.Magnitude

    if FloatingMovedDistance >
        FLOAT_DRAG_THRESHOLD then

        FloatingDragging = true

        local NewCenter =
            FloatingStartPosition +
            Delta

        local Clamped =
            ClampFloatingButton(
                NewCenter
            )

        FloatingButton.Position =
            UDim2.fromOffset(
                math.floor(
                    Clamped.X + 0.5
                ),

                math.floor(
                    Clamped.Y + 0.5
                )
            )
    end
end)

--==============================================================--
--                    FLOATING TOUCH                            --
--==============================================================--

UserInputService.TouchMoved:Connect(function(Input)

    if not FloatingActiveInput then
        return
    end

    if Input ~= FloatingActiveInput then
        return
    end

    if _G.WalkNyxFloatingLocked then
        return
    end

    local CurrentPosition =
        Vector2.new(
            Input.Position.X,
            Input.Position.Y
        )

    local Delta =
        CurrentPosition -
        FloatingDragStart

    FloatingMovedDistance =
        Delta.Magnitude

    if FloatingMovedDistance >
        FLOAT_DRAG_THRESHOLD then

        FloatingDragging = true

        local NewCenter =
            FloatingStartPosition +
            Delta

        local Clamped =
            ClampFloatingButton(
                NewCenter
            )

        FloatingButton.Position =
            UDim2.fromOffset(
                math.floor(
                    Clamped.X + 0.5
                ),

                math.floor(
                    Clamped.Y + 0.5
                )
            )
    end
end)

--==============================================================--
--                    FLOATING INPUT ENDED                      --
--==============================================================--

UserInputService.InputEnded:Connect(function(Input)

    if Input ~= FloatingActiveInput then
        return
    end

    local WasDragging =
        FloatingDragging

    local WasClick =
        not FloatingDragging
        and FloatingMovedDistance <=
            FLOAT_DRAG_THRESHOLD

    FloatingActiveInput = nil
    FloatingDragging = false
    FloatingMovedDistance = 0

    Tween(
        FloatingScale,
        {
            Scale = 1
        },
        0.12
    )

    if WasDragging then
        return
    end

    if not WasClick then
        return
    end

    FloatingClickAnimation()

    if WindowTweening then
        return
    end

    WindowTweening = true

    local Camera =
        workspace.CurrentCamera

    local ViewportHeight =
        Camera
        and Camera.ViewportSize.Y
        or 800

    if WindowVisible then

        LastWindowPosition =
            Window.Position

        Tween(
            Window,
            {
                Position =
                    UDim2.new(
                        Window.Position.X.Scale,
                        Window.Position.X.Offset,
                        0,
                        ViewportHeight + 50
                    )
            },
            0.35
        )

        task.wait(0.35)

        Window.Visible = false
        WindowVisible = false

    else

        Window.Visible = true

        Window.Position =
            UDim2.new(
                LastWindowPosition.X.Scale,
                LastWindowPosition.X.Offset,
                0,
                ViewportHeight + 50
            )

        Tween(
            Window,
            {
                Position =
                    LastWindowPosition
            },
            0.35
        )

        task.wait(0.35)

        WindowVisible = true
    end

    WindowTweening = false
end)

