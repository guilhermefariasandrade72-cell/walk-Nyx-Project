--==============================================================--
--                    ICON CREATOR                             --
--==============================================================--

local function MakeIcon(Parent, IconName)

    if not Icons then
        return nil
    end

    local Success, Result = pcall(function()

        return Icons.Image({
            Icon = IconName,

            Size = UDim2.fromOffset(
                18,
                18
            ),

            Colors = {
                Theme.Icon
            }
        })

    end)

    if not Success then
        return nil
    end

    if not Result then
        return nil
    end

    if not Result.IconFrame then
        return nil
    end

    local IconFrame = Result.IconFrame

    IconFrame.AnchorPoint = Vector2.new(
        0.5,
        0.5
    )

    IconFrame.Position = UDim2.fromScale(
        0.5,
        0.5
    )

    IconFrame.ZIndex = 30

    IconFrame.Parent = Parent

    return IconFrame

end

--==============================================================--
--                     SELECT TAB                              --
--==============================================================--

local function SelectTab(Name)

    ActiveTab = Name

    for TabName, Data in pairs(TabButtons) do

        local Active = TabName == Name

        if Pages[TabName] then
            Pages[TabName].Visible = Active
        end

        if Active then

            Tween(
                Data.Button,
                {
                    BackgroundColor3 = Theme.CardHover
                },
                0.18
            )

            Tween(
                Data.Name,
                {
                    TextColor3 = Theme.Text
                },
                0.18
            )

            Tween(
                Data.Active,
                {
                    BackgroundTransparency = 0
                },
                0.18
            )

            if Data.Icon then

                pcall(function()
                    Data.Icon.ImageColor3 = Theme.IconActive
                end)

            end

        else

            Tween(
                Data.Button,
                {
                    BackgroundColor3 = Theme.Sidebar
                },
                0.18
            )

            Tween(
                Data.Name,
                {
                    TextColor3 = Theme.SubText
                },
                0.18
            )

            Tween(
                Data.Active,
                {
                    BackgroundTransparency = 1
                },
                0.18
            )

            if Data.Icon then

                pcall(function()
                    Data.Icon.ImageColor3 = Theme.Icon
                end)

            end

        end

    end

end

