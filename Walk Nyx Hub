--==============================================================--
--                 MINIMIZAR / RESTAURAR                       --
--==============================================================--

local WindowMinimized = false
local WindowMinimizing = false

local SavedWindowHeight = DEFAULT_H

local function SetMinimized(State)

    if WindowMinimizing then
        return
    end

    if State == WindowMinimized then
        return
    end

    WindowMinimizing = true

    if not State then
        --======================================================--
        --                 RESTAURAR WINDOW                     --
        --======================================================--

        WindowMinimized = false

        Minimize.Text = "—"

        -- Primeiro mostra o conteúdo novamente
        Sidebar.Visible = true
        Content.Visible = true

        -- Começa pequeno
        Window.Size = UDim2.fromOffset(
            Window.AbsoluteSize.X,
            58
        )

        -- Animação abrindo
        local TargetHeight = SavedWindowHeight

        Tween(
            Window,
            {
                Size = UDim2.fromOffset(
                    Window.AbsoluteSize.X,
                    TargetHeight
                )
            },
            0.35
        )

        task.wait(0.35)

    else
        --======================================================--
        --                  MINIMIZAR WINDOW                    --
        --======================================================--

        SavedWindowHeight = Window.AbsoluteSize.Y

        WindowMinimized = true

        Minimize.Text = "＋"

