--==============================================================--
--          FLOATING BUTTON — ANIMAÇÃO CENTRO → FORA           --
--==============================================================--

local FloatingDragging = false
local FloatingDragStart = nil
local FloatingStartPosition = nil
local MovedDistance = 0

local WindowVisible = true
local WindowTweening = false

local LastWindowPosition = Window.Position

FloatingButton.InputBegan:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        FloatingDragging = false
        MovedDistance = 0

        FloatingDragStart = Input.Position

        local AbsPos = FloatingButton.AbsolutePosition

        FloatingStartPosition = Vector2.new(
            AbsPos.X,
            AbsPos.Y
        )

        Input.Changed:Connect(function()

            if Input.UserInputState == Enum.UserInputState.End then

                if not FloatingDragging then

                    --================================================--
                    --                  BOTÃO ANIMATION               --
                    --================================================--

                    TweenService:Create(
                        FloatingScale,
                        TweenInfo.new(0.06),
                        {Scale = 0.85}
                    ):Play()

                    task.wait(0.06)

                    TweenService:Create(
                        FloatingScale,
                        TweenInfo.new(0.10),
                        {Scale = 1.15}
                    ):Play()

                    task.wait(0.10)

                    TweenService:Create(
                        FloatingScale,
                        TweenInfo.new(0.06),
                        {Scale = 1}
                    ):Play()

                    --================================================--
                    --                 OPEN / CLOSE                  --
                    --================================================--

                    if not WindowTweening then

                        WindowTweening = true

                        local Camera = workspace.CurrentCamera

                        local ViewportHeight =
                            Camera and Camera.ViewportSize.Y or 800

                        if WindowVisible then

                            LastWindowPosition = Window.Position

                            Tween(
                                Window,
                                {
                                    Position = UDim2.new(
                                        Window.Position.X.Scale,
                                        Window.Position.X.Offset,
                                        0,
                                        ViewportHeight + 50
                                    )
                                },
                                0.35
                            )

                            task.wait(0.35)

                            Window.Visible = false
                            WindowVisible = false

                        else

                            Window.Visible = true

                            Window.Position = UDim2.new(
                                LastWindowPosition.X.Scale,
                                LastWindowPosition.X.Offset,
                                0,
                                ViewportHeight + 50
                            )

                            Tween(
                                Window,
                                {
                                    Position = LastWindowPosition
                                },
                                0.35
                            )

                            task.wait(0.35)

                            WindowVisible = true
                        end

                        WindowTweening = false
                    end
                end

                FloatingDragStart = nil
                FloatingDragging = false
            end
        end)
    end
end)

--==============================================================--
--                   ARRASTAR BOTÃO WN                          --
--==============================================================--

UserInputService.InputChanged:Connect(function(Input)

    if not FloatingDragStart then
        return
    end

    if Input.UserInputType ~= Enum.UserInputType.MouseMovement
    and Input.UserInputType ~= Enum.UserInputType.Touch then

        return
    end

    local Delta = Input.Position - FloatingDragStart

    MovedDistance = Delta.Magnitude

    if MovedDistance > 5 then

        FloatingDragging = true

        local X =
            FloatingStartPosition.X + Delta.X

        local Y =
            FloatingStartPosition.Y + Delta.Y

        local Camera = workspace.CurrentCamera

        if Camera then

            local Viewport = Camera.ViewportSize

            local W = FloatingButton.AbsoluteSize.X
            local H = FloatingButton.AbsoluteSize.Y

            X = math.clamp(
                X,
                0,
                Viewport.X - W
            )

            Y = math.clamp(
                Y,
                0,
                Viewport.Y - H
            )

            FloatingButton.Position =
                UDim2.fromOffset(X, Y)
        end
    end
end)

