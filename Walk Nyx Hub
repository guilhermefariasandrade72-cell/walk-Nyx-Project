--==============================================================--
--                  UPDATE SIZE SLIDER                          --
--==============================================================--

local function UpdateFloatingSizeSliderVisual()

    local Percentage =
        (
            FloatingButtonSize -
            MIN_FLOATING_SIZE
        )
        /
        (
            MAX_FLOATING_SIZE -
            MIN_FLOATING_SIZE
        )

    Percentage =
        math.clamp(
            Percentage,
            0,
            1
        )

    FloatingSizeFill.Size =
        UDim2.new(
            Percentage,
            0,
            1,
            0
        )

    FloatingSizeKnob.Position =
        UDim2.new(
            Percentage,
            0,
            0.5,
            0
        )

    FloatingSizeValue.Text =
        tostring(FloatingButtonSize) .. " px"
end

local function UpdateFloatingSizeFromX(X)

    local AbsolutePosition =
        FloatingSizeTrack.AbsolutePosition

    local AbsoluteSize =
        FloatingSizeTrack.AbsoluteSize

    if AbsoluteSize.X <= 0 then
        return
    end

    local Percentage =
        math.clamp(
            (
                X -
                AbsolutePosition.X
            )
            /
            AbsoluteSize.X,
            0,
            1
        )

    local NewSize =
        MIN_FLOATING_SIZE +
        (
            MAX_FLOATING_SIZE -
            MIN_FLOATING_SIZE
        )
        * Percentage

    NewSize =
        math.floor(
            NewSize + 0.5
        )

    SetFloatingButtonSize(
        NewSize
    )

    UpdateFloatingSizeSliderVisual()
end

--==============================================================--
--                  SIZE SLIDER INPUT                           --
--==============================================================--

local SizeSliderDragging = false
local SizeSliderTouch = nil

FloatingSizeSlider.InputBegan:Connect(function(Input)

    if Input.UserInputType ==
        Enum.UserInputType.MouseButton1
    or Input.UserInputType ==
        Enum.UserInputType.Touch then

        SizeSliderDragging = true

        if Input.UserInputType ==
            Enum.UserInputType.Touch then

            SizeSliderTouch = Input
        end

        UpdateFloatingSizeFromX(
            Input.Position.X
        )
    end
end)

UserInputService.InputChanged:Connect(function(Input)

    if not SizeSliderDragging then
        return
    end

    if Input.UserInputType ~=
        Enum.UserInputType.MouseMovement then

        return
    end

    UpdateFloatingSizeFromX(
        Input.Position.X
    )
end)

UserInputService.TouchMoved:Connect(function(Input)

    if not SizeSliderDragging then
        return
    end

    if Input ~= SizeSliderTouch then
        return
    end

    UpdateFloatingSizeFromX(
        Input.Position.X
    )
end)

UserInputService.InputEnded:Connect(function(Input)

    if Input.UserInputType ==
        Enum.UserInputType.MouseButton1
    or Input == SizeSliderTouch then

        SizeSliderDragging = false
        SizeSliderTouch = nil
    end
end)

