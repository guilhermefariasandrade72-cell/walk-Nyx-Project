        Enabled = true,
        Anonymous = false,
    },

})


--==============================================================--
-- 5. BOTÃO FLUTUANTE
-- PRETO NA ESQUERDA → BRANCO NA DIREITA
--==============================================================--

OpenButton = Window:EditOpenButton({

    Title = "Murderer Mystery 2",

    Icon = "sparkles",

    CornerRadius = UDim.new(0, 12),

    StrokeThickness = 2,

    Color = ColorSequence.new({

        ColorSequenceKeypoint.new(
            0,
            Color3.fromRGB(0, 0, 0)
        ),

        ColorSequenceKeypoint.new(
            1,
            Color3.fromRGB(255, 255, 255)
        ),

    }),

    Draggable = true,

})


--==============================================================--
-- 6. TAMANHO DO BOTÃO FLUTUANTE
--==============================================================--

task.wait(1)

pcall(function()

    if OpenButton and OpenButton:IsA("GuiObject") then

        EscalaBotao =
            OpenButton:FindFirstChildOfClass("UIScale")

        if not EscalaBotao then

            EscalaBotao = Instance.new("UIScale")

            EscalaBotao.Scale = TamanhoBotao

            EscalaBotao.Parent = OpenButton

        end

    end

end)


