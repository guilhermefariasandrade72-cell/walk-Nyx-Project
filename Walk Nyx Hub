--==============================================================--
--                    VIEWPORT PROTECTION                       --
--==============================================================--

local function UpdateScreen()

    task.defer(function()

        if WindowVisible then
            ClampWindow()
        end

        if not FloatingButton.Parent then
            return
        end

        local Camera =
            workspace.CurrentCamera

        if not Camera then
            return
        end

        -- Only clamp the floating button when
        -- the actual viewport changes.
        -- This does NOT run during slider resizing.

        local AbsolutePosition =
            FloatingButton.AbsolutePosition

        local AbsoluteSize =
            FloatingButton.AbsoluteSize

        local Center =
            Vector2.new(
                AbsolutePosition.X +
                    AbsoluteSize.X / 2,

                AbsolutePosition.Y +
                    AbsoluteSize.Y / 2
            )

        local Clamped =
            ClampFloatingButton(
                Center
            )

        local Difference =
            Clamped - Center

        if Difference.Magnitude > 0.5 then

            FloatingButton.Position =
                UDim2.fromOffset(
                    math.floor(
                        Clamped.X + 0.5
                    ),

                    math.floor(
                        Clamped.Y + 0.5
                    )
                )
        end
    end)
end

if workspace.CurrentCamera then

    workspace.CurrentCamera
        :GetPropertyChangedSignal(
            "ViewportSize"
        )
        :Connect(UpdateScreen)

end

