    Title = "Murderer Mystery 2",

    Icon = "sparkles",

    Author = "Walk Nyx Project",

    Size = UDim2.fromOffset(520, 360),

    MinSize = Vector2.new(420, 300),

    MaxSize = Vector2.new(600, 430),

