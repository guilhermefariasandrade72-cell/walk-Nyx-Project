--==============================================================--

local function CenterWindow()

    local Camera =
        workspace.CurrentCamera

    if not Camera then
        return
    end

    local Viewport =
        Camera.ViewportSize

    local X =
        math.floor(
            (Viewport.X - DEFAULT_W) / 2
        )

    local Y =
        math.floor(
            (Viewport.Y - DEFAULT_H) / 2
        )

    Window.Position =
        UDim2.fromOffset(
            math.max(0, X),
            math.max(0, Y)
        )

    LastWindowPosition =
        Window.Position
end

