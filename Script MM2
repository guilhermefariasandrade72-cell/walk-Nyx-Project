            Resizing =
                true

            ResizeStart =
                Input.Position

            StartWidth =
                Main.AbsoluteSize.X

            StartHeight =
                Main.AbsoluteSize.Y

        end
    end
)

UserInputService.InputChanged:Connect(
    function(Input)

        if not Resizing then
            return
        end

        if IsMinimized
        or IsMaximized then
            return
        end

        if Input.UserInputType ==
            Enum.UserInputType.MouseMovement

        or Input.UserInputType ==
            Enum.UserInputType.Touch then

            local Delta =
                Input.Position
                - ResizeStart

            local NewWidth =
                math.clamp(

                    StartWidth + Delta.X,

                    MIN_WIDTH,
                    MAX_WIDTH

                )

            local NewHeight =
                math.clamp(

                    StartHeight + Delta.Y,

                    MIN_HEIGHT,
                    MAX_HEIGHT

                )

            Main.Size =
                UDim2.fromOffset(

                    NewWidth,
                    NewHeight

                )

        end
    end
)

