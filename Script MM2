-- 31. SISTEMA DE SELEÇÃO ANIMADA (OTIMIZADO)
--==================================================

local CurrentTab = nil

local function SelectTab(Name)
    if not Name then return end
    if CurrentTab == Name then return end

    local TargetTabData = Tabs[Name]
    local TargetPage = Pages[Name]
    if not TargetTabData or not TargetPage then return end

    CurrentTab = Name

    -- Atualiza cores do texto e esconde indicadores das outras abas
    for TabName, Data in pairs(Tabs) do
        local IsTarget = (TabName == Name)
        
        Data.Button.TextColor3 = IsTarget and White or Gray
        Data.Indicator.Visible = IsTarget
    end

    -- Mostra a página correta e esconde as outras
    for PageName, Page in pairs(Pages) do
        Page.Visible = (PageName == Name)
    end

    -- Anima a linha da aba selecionada
    local Indicator = TargetTabData.Indicator
    Indicator.Size = UDim2.fromOffset(3, 0)
    Indicator.Position = UDim2.new(0, 7, 0.5, 0)

    TweenService:Create(Indicator, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(3, 20),
        Position = UDim2.new(0, 7, 0.5, -10)
    }):Play()
end


