--==================================================
-- 50. MAXIMIZAR / RESTAURAR
--==================================================

local IsMaximized =
    false

local PreviousSize =
    nil

local PreviousPosition =
    nil

local function GetMaximizedSize()

    local Camera =
        workspace.CurrentCamera

    if not Camera then

        return
            WINDOW_WIDTH,
            WINDOW_HEIGHT

    end

    local Viewport =
        Camera.ViewportSize

    local TargetWidth =
        Viewport.X * 0.80

    local TargetHeight =
        Viewport.Y * 0.82

    local Scale =
        UIScale.Scale

    if Scale > 0 then

        TargetWidth =
            TargetWidth / Scale

        TargetHeight =
            TargetHeight / Scale

    end

    TargetWidth =
        math.clamp(

            TargetWidth,

            MIN_WIDTH,
            MAX_WIDTH

        )

    TargetHeight =
        math.clamp(

            TargetHeight,

            MIN_HEIGHT,
            MAX_HEIGHT

        )

    return
        TargetWidth,
        TargetHeight
end

Maximize.Activated:Connect(
    function()

        if IsMinimized then
            return
        end

        if not IsMaximized then

            --======================================
            -- SALVAR TAMANHO ATUAL
            --======================================

            PreviousSize =
                Main.Size

            PreviousPosition =
                Main.Position

            local TargetWidth,
                TargetHeight =
                GetMaximizedSize()

            IsMaximized =
                true

            Maximize.Text =
                "❐"

            TweenService:Create(

                Main,

                TweenInfo.new(
                    0.3,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.Out
                ),

                {

                    Size =
                        UDim2.fromOffset(

                            TargetWidth,
                            TargetHeight

                        ),

                    Position =
                        UDim2.new(

                            0.5,
                            0,

                            0.5,
                            -TargetHeight / 2

                        )

                }

            ):Play()

        else

            --======================================
            -- RESTAURAR TAMANHO
            --======================================

            if PreviousSize
            and PreviousPosition then

                IsMaximized =
                    false

                Maximize.Text =
                    "□"

                TweenService:Create(

                    Main,

                    TweenInfo.new(
                        0.3,
                        Enum.EasingStyle.Quart,
                        Enum.EasingDirection.Out
                    ),

                    {

                        Size =
                            PreviousSize,

                        Position =
                            PreviousPosition

                    }

                ):Play()

            end
        end
    end
)

