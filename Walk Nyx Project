--==============================================================--
--                    WALK NYX INTRO                            --
--==============================================================--

if _G.WalkNyxRunning then
    return
end

_G.WalkNyxRunning = true

--==============================================================--
--                    SERVIÇOS                                  --
--==============================================================--

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--==============================================================--
--              REMOVE INTRO ANTIGA                             --
--==============================================================--

local OldIntro = PlayerGui:FindFirstChild("WalkNyxIntro")

if OldIntro then
    OldIntro:Destroy()
end

--==============================================================--
--                    INTRO GUI                                 --
--==============================================================--

local Intro = Instance.new("ScreenGui")
Intro.Name = "WalkNyxIntro"
Intro.ResetOnSpawn = false
Intro.IgnoreGuiInset = true
Intro.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
Intro.Parent = PlayerGui

--==============================================================--
--                    FUNDO                                     --
--==============================================================--

local Background = Instance.new("Frame")
Background.Name = "Background"
Background.Size = UDim2.fromScale(1, 1)
Background.Position = UDim2.fromScale(0, 0)
Background.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
Background.BorderSizePixel = 0
Background.Parent = Intro

--==============================================================--
--                    WALK NYX                                  --
--==============================================================--

local WalkNyx = Instance.new("TextLabel")
WalkNyx.Name = "WalkNyx"
WalkNyx.BackgroundTransparency = 1
WalkNyx.Size = UDim2.fromOffset(300, 60)
WalkNyx.AnchorPoint = Vector2.new(0.5, 0.5)
WalkNyx.Position = UDim2.fromScale(0.5, 0.45)
WalkNyx.Text = "W a l k   N y x"
WalkNyx.TextColor3 = Color3.fromRGB(255, 255, 255)
WalkNyx.TextTransparency = 0
WalkNyx.Font = Enum.Font.GothamBold
WalkNyx.TextSize = 30
WalkNyx.TextXAlignment = Enum.TextXAlignment.Center
WalkNyx.Parent = Intro

--==============================================================--
--                    HUB PROJECT                               --
--==============================================================--

local HubProject = Instance.new("TextLabel")
HubProject.Name = "HubProject"
HubProject.BackgroundTransparency = 1
HubProject.Size = UDim2.fromOffset(420, 60)
HubProject.AnchorPoint = Vector2.new(0.5, 0.5)
HubProject.Position = UDim2.fromScale(0.90, 0.45)
HubProject.Text = "H u b   P r o j e c t"
HubProject.TextColor3 = Color3.fromRGB(255, 255, 255)
HubProject.TextTransparency = 1
HubProject.Font = Enum.Font.GothamBold
HubProject.TextSize = 30
HubProject.TextXAlignment = Enum.TextXAlignment.Left
HubProject.Parent = Intro

--==============================================================--
--                    SLIDER                                    --
--==============================================================--

local SliderBack = Instance.new("Frame")
SliderBack.Name = "SliderBack"
SliderBack.Size = UDim2.fromOffset(360, 8)
SliderBack.AnchorPoint = Vector2.new(0.5, 0.5)
SliderBack.Position = UDim2.fromScale(0.5, 0.57)
SliderBack.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
SliderBack.BorderSizePixel = 0
SliderBack.Parent = Intro

local SliderCorner = Instance.new("UICorner")
SliderCorner.CornerRadius = UDim.new(1, 0)
SliderCorner.Parent = SliderBack

local SliderFill = Instance.new("Frame")
SliderFill.Name = "SliderFill"
SliderFill.Size = UDim2.new(0, 0, 1, 0)
SliderFill.Position = UDim2.fromScale(0, 0)
SliderFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
SliderFill.BorderSizePixel = 0
SliderFill.Parent = SliderBack

local FillCorner = Instance.new("UICorner")
FillCorner.CornerRadius = UDim.new(1, 0)
FillCorner.Parent = SliderFill

--==============================================================--
--                    PORCENTAGEM                                --
--==============================================================--

local Percentage = Instance.new("TextLabel")
Percentage.Name = "Percentage"
Percentage.BackgroundTransparency = 1
Percentage.Size = UDim2.fromOffset(150, 35)
Percentage.AnchorPoint = Vector2.new(0.5, 0.5)
Percentage.Position = UDim2.fromScale(0.5, 0.63)
Percentage.Text = "0%"
Percentage.TextColor3 = Color3.fromRGB(255, 255, 255)
Percentage.Font = Enum.Font.Gotham
Percentage.TextSize = 16
Percentage.Parent = Intro

--==============================================================--
--                    CARREGAMENTO                              --
--==============================================================--

for i = 0, 100 do

    if not Intro or not Intro.Parent then
        _G.WalkNyxRunning = false
        return
    end

    SliderFill.Size = UDim2.new(i / 100, 0, 1, 0)
    Percentage.Text = tostring(i) .. "%"

    task.wait(0.025)
end

--==============================================================--
--             WALK NYX VAI PARA A ESQUERDA                     --
--==============================================================--

WalkNyx.TextXAlignment = Enum.TextXAlignment.Right

local MoveWalkNyx = TweenService:Create(
    WalkNyx,
    TweenInfo.new(
        0.8,
        Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    ),
    {
        Position = UDim2.fromScale(0.30, 0.45)
    }
)

MoveWalkNyx:Play()

--==============================================================--
--             HUB PROJECT ENTRA PELA DIREITA                   --
--==============================================================--

local MoveHubProject = TweenService:Create(
    HubProject,
    TweenInfo.new(
        0.8,
        Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    ),
    {
        Position = UDim2.fromScale(0.69, 0.45),
        TextTransparency = 0
    }
)

MoveHubProject:Play()

task.wait(0.9)

--==============================================================--
--                    PAUSA                                    --
--==============================================================--

task.wait(0.5)

--==============================================================--
--                    FADE OUT                                 --
--==============================================================--

local FadeInfo = TweenInfo.new(
    1,
    Enum.EasingStyle.Quad,
    Enum.EasingDirection.Out
)

TweenService:Create(
    WalkNyx,
    FadeInfo,
    {
        TextTransparency = 1
    }
):Play()

TweenService:Create(
    HubProject,
    FadeInfo,
    {
        TextTransparency = 1
    }
):Play()

TweenService:Create(
    SliderBack,
    FadeInfo,
    {
        BackgroundTransparency = 1
    }
):Play()

TweenService:Create(
    SliderFill,
    FadeInfo,
    {
        BackgroundTransparency = 1
    }
):Play()

TweenService:Create(
    Percentage,
    FadeInfo,
    {
        TextTransparency = 1
    }
):Play()

TweenService:Create(
    Background,
    FadeInfo,
    {
        BackgroundTransparency = 1
    }
):Play()

task.wait(1.1)

--==============================================================--
--                    REMOVE INTRO                              --
--==============================================================--

if Intro and Intro.Parent then
    Intro:Destroy()
end

--==============================================================--
--             EXECUTA O WALK NYX HUB                          --
--==============================================================--

local Success, ErrorMessage = pcall(function()

    loadstring(game:HttpGet(
        "https://raw.githubusercontent.com/guilhermefariasandrade72-cell/walk-Nyx-Project/refs/heads/main/Walk%20Nyx%20Hub"
    ))()

end)

-- Libera para uma nova execução depois que terminar
_G.WalkNyxRunning = false

if not Success then
    warn("Erro ao executar Walk Nyx Hub:", ErrorMessage)
end
