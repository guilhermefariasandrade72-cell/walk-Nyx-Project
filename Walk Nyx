    ConfirmOverlay.Visible = false
    WindowOpen = false
    ClearFloatDragConnections()
    if ScreenGui then ScreenGui:Destroy() end
    if FloatGui then FloatGui:Destroy() end
end)

workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    if not FloatButton.Parent then return end
    local ClampedPosition = ClampFloatButton(FloatButton.AbsolutePosition)
    FloatButton.Position = UDim2.fromOffset(math.floor(ClampedPosition.X + 0.5), math.floor(ClampedPosition.Y + 0.5))
end)
