local function CreateLucideIcon(Parent, IconName, IconColor, IconSize)
    IconSize = IconSize or 20

    local Image = Instance.new("ImageLabel")
    Image.Name = "Icon"
    Image.Size = UDim2.fromOffset(IconSize, IconSize)
    Image.AnchorPoint = Vector2.new(0.5, 0.5)
    Image.Position = UDim2.fromScale(0.5, 0.5)
    Image.BackgroundTransparency = 1
    Image.Image = IconAssets[IconName] or IconAssets.house
    Image.ImageColor3 = IconColor
    Image.ScaleType = Enum.ScaleType.Fit
    Image.Parent = Parent

    return Image
end

