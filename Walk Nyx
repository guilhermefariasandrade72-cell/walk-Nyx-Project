local function RemoveInvisivelButton()
    if InvisivelButtonGui then 
        InvisivelButtonGui:Destroy() 
        InvisivelButtonGui = nil 
    end
    InvisivelAtivo = false
end

local function CreateInvisivelButton()
    if InvisivelButtonGui then return end

    local ParentGui = CoreGui
    pcall(function()
        if not CoreGui then ParentGui = Player:WaitForChild("PlayerGui") end
    end)

    local GuiBtn = Instance.new("ScreenGui")
    GuiBtn.Name = "AstralX_InvisivelButton"
    GuiBtn.ResetOnSpawn = false
    GuiBtn.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    GuiBtn.Parent = ParentGui

    -- Botão quadrado 70x70 com bordas arredondadas (UICorner)
    local Btn = Instance.new("ImageButton")
    Btn.Size = UDim2.new(0, 70, 0, 70)
    Btn.Position = UDim2.new(0.5, -35, 0.3, -35)
    Btn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    Btn.BackgroundTransparency = 0.3 -- Semi preto no centro
    Btn.BorderSizePixel = 0
    Btn.Parent = GuiBtn

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 12) -- Bordas arredondadas
    Corner.Parent = Btn

    -- Linha contornando em volta
    local Borda = Instance.new("UIStroke")
    Borda.Color = Color3.fromRGB(255, 0, 0) -- Vermelho desligado
    Borda.Thickness = 3
    Borda.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Borda.Parent = Btn

    -- Texto "Invisible" no centro-superior
    local Texto = Instance.new("TextLabel")
    Texto.Size = UDim2.new(1, 0, 0, 20)
    Texto.Position = UDim2.new(0, 0, 0, 15)
    Texto.BackgroundTransparency = 1
    Texto.Text = "Invisible"
    Texto.TextColor3 = Color3.fromRGB(255, 255, 255)
    Texto.TextSize = 12
    Texto.Font = Enum.Font.GothamBold
    Texto.Parent = Btn

    -- Texto "Off" / "On" logo abaixo do "Invisible"
    local StatusTexto = Instance.new("TextLabel")
    StatusTexto.Name = "StatusText"
    StatusTexto.Size = UDim2.new(1, 0, 0, 15)
    StatusTexto.Position = UDim2.new(0, 0, 0, 35)
    StatusTexto.BackgroundTransparency = 1
    StatusTexto.Text = "Off"
    StatusTexto.TextColor3 = Color3.fromRGB(255, 50, 50)
    StatusTexto.TextSize = 11
    StatusTexto.Font = Enum.Font.GothamSemibold
    StatusTexto.Parent = Btn

    local dragThreshold = 10
    local dragStartMousePos, buttonStartPosScreen

    Btn.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDraggingInvis = false
            dragStartMousePos = Input.Position
            buttonStartPosScreen = Btn.Position
        end
    end)

    Btn.InputChanged:Connect(function(Input)
        if (Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseMovement) and dragStartMousePos then
            local delta = Input.Position - dragStartMousePos
            if delta.Magnitude > dragThreshold then
                isDraggingInvis = true
                Btn.Position = buttonStartPosScreen + UDim2.fromOffset(delta.X, delta.Y)
            end
        end
    end)

    Btn.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
            if not isDraggingInvis then
                InvisivelAtivo = not InvisivelAtivo

                if InvisivelAtivo then
                    Borda.Color = Color3.fromRGB(0, 255, 0) -- Verde quando ligado
                    StatusTexto.Text = "On"
                    StatusTexto.TextColor3 = Color3.fromRGB(0, 255, 0)
                else
                    Borda.Color = Color3.fromRGB(255, 0, 0) -- Vermelho quando desligado
                    StatusTexto.Text = "Off"
                    StatusTexto.TextColor3 = Color3.fromRGB(255, 50, 50)
                end
            end
            dragStartMousePos = nil
            isDraggingInvis = false
        end
    end)

    InvisivelButtonGui = GuiBtn
end


