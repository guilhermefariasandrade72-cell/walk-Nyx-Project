    BtnCorner.Parent = Btn

    -- 🔴 BORDA VERMELHA
    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(225, 40, 56)
    BtnStroke.Thickness = 2
    BtnStroke.Transparency = 0
    BtnStroke.Parent = Btn

    -- ✅ AO CLICAR — JOGA A FACA COM O SISTEMA INTELIGENTE
    Btn.Activated:Connect(function()
        ThrowKnife(Btn)
        TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60, 10, 10)}):Play()
        task.wait(0.1)
        TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(30, 0, 0)}):Play()
    end)

    -- 🖱️ ARRASTAR BOTÃO
    local DragStart, StartPos
    Btn.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            DragStart = Input.Position
            StartPos = Btn.Position
        end
    end)

    Btn.InputChanged:Connect(function(Input)
        if isDragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
            local Delta = Input.Position - DragStart
            Btn.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y)
        end
    end)

    Btn.InputEnded:Connect(function()
        isDragging = false
    end)
end

