local function AplicarXRay()
    for _, Descendente in ipairs(workspace:GetDescendants()) do
        if Descendente:IsA("BasePart") and not Descendente:IsA("Terrain") then
            
            -- ✅ IGNORA PERSONAGENS DE JOGADORES
            local EhJogador = false
            for _, Jogador in ipairs(Players:GetPlayers()) do
                if Jogador.Character and Descendente:IsDescendantOf(Jogador.Character) then
                    EhJogador = true
                    break
                end
            end
            
            if not EhJogador then
                if not ValoresOriginais[Descendente] then
                    ValoresOriginais[Descendente] = {Transparency = Descendente.Transparency, LocalTransparencyModifier = Descendente.LocalTransparencyModifier}
                end
                Descendente.LocalTransparencyModifier = 0.65 -- Semi-transparente
            end
        end
    end
end

local function RemoverXRay()
    for Parte, Valores in pairs(ValoresOriginais) do
        if Parte and Parte:IsDescendantOf(workspace) then
            Parte.LocalTransparencyModifier = Valores.LocalTransparencyModifier
        end
    end
    table.clear(ValoresOriginais)
end

task.spawn(function()
    while task.wait(0.5) do
        if XRayAtivo then
            AplicarXRay()
        else
            if next(ValoresOriginais) then
                RemoverXRay()
            end
        end
    end
end)

