                    AvatarImg.Size = UDim2.fromOffset(20, 20)
                    AvatarImg.Position = UDim2.new(0, 6, 0.5, -10)
                    AvatarImg.BackgroundTransparency = 1
                    AvatarImg.ZIndex = 8
                    AvatarImg.Parent = PlayerBtn

                    local AvatarCorner = Instance.new("UICorner")
                    AvatarCorner.CornerRadius = UDim.new(0, 4)
                    AvatarCorner.Parent = AvatarImg

                    pcall(function()
                        AvatarImg.Image = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                    end)

                    local NameLabel = Instance.new("TextLabel")
