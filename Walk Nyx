local FarmMax = 25
local FarmValue = 18

local function AtualizarFarmSlider(valor)
    valor = math.clamp(valor, FarmMin, FarmMax)
    FarmValue = math.floor(valor + 0.5)
    local porcentagem = (FarmValue - FarmMin) / (FarmMax - FarmMin)
    FarmSliderFill.Size = UDim2.new(porcentagem, 0, 1, 0)
    FarmSliderButton.Position = UDim2.new(porcentagem, 0, 0.5, 0)
    FarmSliderValue.Text = tostring(FarmValue)
    CONFIG_FARM.velocidade = FarmValue
end

