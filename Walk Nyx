-- ==================================
-- ✅ DISPARADOR DE ANIMAÇÃO CENTRALIZADO
-- ==================================
local function DispararAlerta(textoMensagem, corBorda)
    if AnimandoNotificacao then return end
    if not NotificacaoGui then CriarNotificacao() end
    
    local NotifBox = NotificacaoGui:FindFirstChild("NotifBox")
    if not NotifBox then return end
    
    AnimandoNotificacao = true
    NotifBox.Mensagem.Text = textoMensagem
    NotifBox.Stroke.Color = corBorda
    NotifBox.Visible = true
    
    local tweenInfoIn = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local tweenInfoOut = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    
    local tweenEntrada = TweenService:Create(NotifBox, tweenInfoIn, {Position = UDim2.new(1, -20, 1, -20)})
    tweenEntrada:Play()
    tweenEntrada.Completed:Wait()
    
    task.wait(4)
    
    local tweenSaida = TweenService:Create(NotifBox, tweenInfoOut, {Position = UDim2.new(1, 320, 1, -20)})
    tweenSaida:Play()
    tweenSaida.Completed:Wait()
    
    NotifBox.Visible = false
    AnimandoNotificacao = false
end


-- ==================================
-- 🔄 LOOP PRINCIPAL DE MONITORAMENTO
-- ==================================
task.spawn(function()
    CriarNotificacao()
    while true do
        task.wait(0.5)
        
        -- 1. Checagem Murderer
        if MostrarNotifMurderer then
            local MurdererAtual = getPlayerByRole("Murderer")
            if MurdererAtual and MurdererAtual ~= UltimoMurdererNotificado then
                UltimoMurdererNotificado = MurdererAtual
                DispararAlerta(MurdererAtual.Name .. " is the Murderer", Color3.fromRGB(225, 40, 56))
            elseif not MurdererAtual then
                UltimoMurdererNotificado = nil
            end
        end
        
        -- 2. Checagem Sheriff
        if MostrarNotifSheriff then
            local SheriffAtual = getPlayerByRole("Sheriff")
            if SheriffAtual and SheriffAtual ~= UltimoSheriffNotificado then
                UltimoSheriffNotificado = SheriffAtual
                DisprandoTexto = SheriffAtual.Name .. " is the Sheriff"
                DispararAlerta(DisprandoTexto, Color3.fromRGB(40, 120, 225))
            elseif not SheriffAtual then
                UltimoSheriffNotificado = nil
            end
        end
        
        -- 3. Checagem Herói
        if MostrarNotifHero then
            local HeroAtual = getPlayerByRole("Hero")
            if HeroAtual and HeroAtual ~= UltimoHeroNotificado then
                UltimoHeroNotificado = HeroAtual
                DispararAlerta(HeroAtual.Name .. " is the Hero", Color3.fromRGB(210, 170, 30))
            elseif not HeroAtual then
                UltimoHeroNotificado = nil
            end
        end
        
    end
end)

