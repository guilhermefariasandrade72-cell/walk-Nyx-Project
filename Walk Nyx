-- ==================================
-- SISTEMA — FLING INTELIGENTE
-- ==================================
local function executeCustomFling(targetPlr)
    if isFlinging then return end
    if not targetPlr or not targetPlr.Character then return end
    
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end
    
    local targetRoot = targetPlr.Character:FindFirstChild("HumanoidRootPart")
    local targetHum = targetPlr.Character:FindFirstChild("Humanoid")
    if not targetRoot then return end

    isFlinging = true
    local oldCFrame = root.CFrame

    hum.PlatformStand = true

    local noclipConnection
    noclipConnection = RunService.Stepped:Connect(function()
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)

    local spin = Instance.new("BodyAngularVelocity")
    spin.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    spin.AngularVelocity = Vector3.new(120000, 120000, 120000)
    spin.P = math.huge
    spin.Parent = root

    local startTime = tick()
    local flingConnection

    flingConnection = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - startTime
        
        if targetRoot and root then
            local isTargetStandingStill = false
            if targetHum and targetHum.MoveDirection.Magnitude < 0.05 and targetRoot.Velocity.Magnitude < 0.5 then
                isTargetStandingStill = true
            end

            local angle = elapsed * 60
            local offsetX, offsetY, offsetZ = 0, 0, 0

            if isTargetStandingStill then
                offsetX = 0
                offsetY = 0
                offsetZ = 0
            else
                offsetX = math.sin(angle * 1.5) * 2.5
                offsetY = math.cos(angle * 2) * 2.5
                offsetZ = -3 + (math.sin(angle * 1.2) * 2.5)
            end
            
            root.CFrame = targetRoot.CFrame * CFrame.new(offsetX, offsetY, offsetZ) * targetRoot.CFrame.Rotation * CFrame.Angles(elapsed * 60, elapsed * 70, elapsed * 65)
            root.Velocity = Vector3.new(120000, 120000, 120000)
        end
    end)

    task.wait(3)

    if flingConnection then flingConnection:Disconnect() end
    if spin then spin:Destroy() end

    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero
    root.CFrame = oldCFrame + Vector3.new(0, 5, 0)
    
    local holdConnection
    holdConnection = RunService.Heartbeat:Connect(function()
        if root then
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
            root.CFrame = oldCFrame + Vector3.new(0, 5, 0)
        end
    end)

    task.wait(0.5)

    if holdConnection then holdConnection:Disconnect() end
    if noclipConnection then noclipConnection:Disconnect() end
    
    hum.PlatformStand = false
    isFlinging = false
end

