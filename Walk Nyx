--==============================================================--
-- DRAG MAIN
--==============================================================--

Header.InputBegan:Connect(
    function(Input)

        if Input.UserInputType
            ~= Enum.UserInputType.MouseButton1

            and Input.UserInputType
            ~= Enum.UserInputType.Touch then

            return
        end

        DraggingWindow = true

        local StartPosition =
            Input.Position

        local StartWindowPosition =
            Main.Position

        local Changed
        local Ended

        Changed =
            UserInputService.InputChanged:Connect(
                function(Change)

                    if not DraggingWindow then
                        return
                    end

                    if Change.UserInputType
                        == Enum.UserInputType.MouseMovement

                        or Change.UserInputType
                        == Enum.UserInputType.Touch then

                        local Delta =
                            Change.Position -
                            StartPosition

                        Main.Position =
                            UDim2.new(
                                StartWindowPosition.X.Scale,

                                StartWindowPosition.X.Offset
                                    + Delta.X,

                                StartWindowPosition.Y.Scale,

                                StartWindowPosition.Y.Offset
                                    + Delta.Y
                            )
                    end
                end
            )

        Ended =
            UserInputService.InputEnded:Connect(
                function(EndedInput)

                    if EndedInput.UserInputType
                        == Enum.UserInputType.MouseButton1

                        or EndedInput.UserInputType
                        == Enum.UserInputType.Touch then

                        DraggingWindow = false

                        if Changed then
                            Changed:Disconnect()
                        end

                        if Ended then
                            Ended:Disconnect()
                        end
                    end
                end
            )
    end
)

