                                and Theme.AccentBright
                                or Theme.TextSecondary

                        elseif OtherIcon:IsA(
                            "TextLabel"
                        ) then

                            OtherIcon.TextColor3 =
                                Selected
                                and Theme.AccentBright
                                or Theme.TextSecondary
                        end
                    end
                end
            end

            PageTitle.Text =
                TabData.Name

            PageDesc.Text =
                TabData.Description
        end
    )

