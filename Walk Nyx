--==============================================================--
-- ÍCONE LUCIDE
--==============================================================--

local function CreateLucideIcon(
    Parent,
    IconName,
    IconColor,
    IconSize
)

    IconSize = IconSize or 21

    if not Lucide then

        warn(
            "[Astral X] Lucide não encontrado em ReplicatedStorage."
        )

        local Fallback =
            Instance.new("TextLabel")

        Fallback.Name = "Icon"

        Fallback.Size =
            UDim2.fromOffset(
                IconSize,
                IconSize
            )

        Fallback.AnchorPoint =
            Vector2.new(
                0.5,
                0.5
            )

        Fallback.Position =
            UDim2.fromScale(
                0.5,
                0.5
            )

        Fallback.BackgroundTransparency = 1

        Fallback.TextColor3 =
            IconColor

        Fallback.TextSize =
            math.floor(
                IconSize * 0.8
            )

        Fallback.Font =
            Enum.Font.GothamBold

        local FallbackIcons = {
            house = "⌂",
            eye = "◉",
            user = "●",
            settings = "⚙",
            x = "×",
        }

        Fallback.Text =
            FallbackIcons[IconName]
            or "•"

        Fallback.Parent =
            Parent

        return Fallback
    end

    local Success, Asset =
        pcall(function()

            return Lucide.GetAsset(
                IconName,
                IconSize
            )

        end)

    if not Success or not Asset then

        warn(
            "[Astral X] Ícone Lucide inválido: "
                .. tostring(IconName)
        )

        return nil
    end

    local Image =
        Instance.new("ImageLabel")

    Image.Name =
        "Icon"

    Image.Size =
        UDim2.fromOffset(
            IconSize,
            IconSize
        )

    Image.AnchorPoint =
        Vector2.new(
            0.5,
            0.5
        )

    Image.Position =
        UDim2.fromScale(
            0.5,
            0.5
        )

    Image.BackgroundTransparency = 1

    Image.Image =
        Asset.Url

    Image.ImageColor3 =
        IconColor

    Image.ScaleType =
        Enum.ScaleType.Fit

    Image.Parent =
        Parent

    return Image
end

