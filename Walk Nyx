ResizeButton.InputBegan:Connect(
    function(Input)

        if Input.UserInputType
            ~= Enum.UserInputType.MouseButton1

            and Input.UserInputType
            ~= Enum.UserInputType.Touch then

            return
        end

        Resizing = true

        local StartPosition =
            Input.Position

        local StartWidth =
            Main.AbsoluteSize.X

        local StartHeight =
            Main.AbsoluteSize.Y

        local Changed
        local Ended

        Changed =
            UserInputService.InputChanged:Connect(
                function(Change)

                    if not Resizing then
                        return
                    end

                    if Change.UserInputType
                        == Enum.UserInputType.MouseMovement

                        or Change.UserInputType
                        == Enum.UserInputType.Touch then

                        local Delta =
                            Change.Position -
                            StartPosition

                        CurrentWidth =
                            math.clamp(
                                StartWidth +
                                    Delta.X,

                                MIN_WIDTH,
                                MAX_WIDTH
                            )

                        CurrentHeight =
                            math.clamp(
                                StartHeight +
                                    Delta.Y,

                                MIN_HEIGHT,
                                MAX_HEIGHT
                            )

                        Main.Size =
                            UDim2.fromOffset(
                                CurrentWidth,
                                CurrentHeight
                            )
                    end
                end
            )

        Ended =
            UserInputService.InputEnded:Connect(
                function(EndedInput)

                    if EndedInput.UserInputType
                        == Enum.UserInputType.MouseButton1

                        or EndedInput.UserInputType
                        == Enum.UserInputType.Touch then

                        Resizing = false

                        if Changed then
                            Changed:Disconnect()
                        end

                        if Ended then
                            Ended:Disconnect()
                        end
                    end
                end
            )
    end
)

