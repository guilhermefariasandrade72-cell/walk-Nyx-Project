--==============================================================--

local function HideWindow()

    if WindowAnimating
        or not WindowOpen then
        return
    end

    WindowAnimating = true
    WindowOpen = false

    local HiddenWidth =
        math.floor(
            CurrentWidth * 0.82
        )

    local HiddenHeight =
        math.floor(
            CurrentHeight * 0.82
        )

    local SizeTween =
        TweenService:Create(
            Main,
            TweenInfo.new(
                0.28,
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.In
            ),
            {
                Size =
                    UDim2.fromOffset(
                        HiddenWidth,
                        HiddenHeight
                    )
            }
        )

    local FadeTween =
        TweenService:Create(
            WindowGroup,
            TweenInfo.new(
                0.24,
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.In
            ),
            {
                GroupTransparency = 1
            }
        )

    SizeTween:Play()
    FadeTween:Play()

    FadeTween.Completed:Connect(function()

        if not ScreenGui.Parent then
            return
        end

        Main.Visible = false

        Main.Size =
            UDim2.fromOffset(
                CurrentWidth,
                CurrentHeight
            )

        WindowGroup.GroupTransparency = 0
        WindowAnimating = false

    end)

end

--==============================================================--
-- MOSTRAR JANELA
--==============================================================--

local function ShowWindow()

    if WindowAnimating
        or WindowOpen then
        return
    end

    WindowAnimating = true
    WindowOpen = true

    Main.Visible = true

    Main.Size =
        UDim2.fromOffset(
            math.floor(CurrentWidth * 0.82),
            math.floor(CurrentHeight * 0.82)
        )

    WindowGroup.GroupTransparency = 1

    local SizeTween =
        TweenService:Create(
            Main,
            TweenInfo.new(
                0.32,
                Enum.EasingStyle.Back,
                Enum.EasingDirection.Out
            ),
            {
                Size =
                    UDim2.fromOffset(
                        CurrentWidth,
                        CurrentHeight
                    )
            }
        )

    local FadeTween =
        TweenService:Create(
            WindowGroup,
            TweenInfo.new(
                0.26,
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.Out
            ),
            {
                GroupTransparency = 0
            }
        )

    SizeTween:Play()
    FadeTween:Play()

    FadeTween.Completed:Connect(function()
        WindowAnimating = false
    end)

end

