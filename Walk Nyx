                local OtherIconHolder =
                    OtherButton:FindFirstChild(
                        "IconHolder"
                    )

                if OtherIconHolder then

                    local OtherIcon =
                        OtherIconHolder:FindFirstChild(
                            "Icon"
                        )

                    if OtherIcon then

                        if OtherIcon:IsA(
