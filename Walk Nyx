--==============================================================--
-- LIMITAR BOTÃO NA TELA
--==============================================================--

local function ClampFloatButton(Position)

    local Camera = workspace.CurrentCamera

    if not Camera then
        return Position
    end

    local ViewportSize = Camera.ViewportSize
    local ButtonSize = FloatButton.AbsoluteSize

    local MaxX =
        math.max(
            0,
            ViewportSize.X - ButtonSize.X
        )

    local MaxY =
        math.max(
            0,
            ViewportSize.Y - ButtonSize.Y
        )

    local X =
        math.clamp(
            Position.X,
            0,
            MaxX
        )

    local Y =
        math.clamp(
            Position.Y,
            0,
            MaxY
        )

    return Vector2.new(X, Y)
end

--==============================================================--
-- LIMPAR CONEXÕES
--==============================================================--

local function ClearFloatDragConnections()

    if FloatMouseChangedConnection then
        FloatMouseChangedConnection:Disconnect()
        FloatMouseChangedConnection = nil
    end

    if FloatTouchMovedConnection then
        FloatTouchMovedConnection:Disconnect()
        FloatTouchMovedConnection = nil
    end

    if FloatInputEndedConnection then
        FloatInputEndedConnection:Disconnect()
        FloatInputEndedConnection = nil
    end

end

--==============================================================--
-- FINALIZAR DRAG
--==============================================================--

local function StopFloatDrag()

    ClearFloatDragConnections()

    FloatDragInput = nil
    FloatDragStart = nil
    FloatStartPosition = nil
    FloatGrabOffset = nil

    task.defer(function()
        DraggingFloat = false
    end)

end

--==============================================================--
-- ATUALIZAR POSIÇÃO
--==============================================================--

local function UpdateFloatPosition(CurrentPosition)

    if not FloatDragStart
        or not FloatStartPosition then
        return
    end

    local Delta =
        CurrentPosition - FloatDragStart

    if not DraggingFloat then

        if Delta.Magnitude < FloatDragThreshold then
            return
        end

        DraggingFloat = true

    end

    local NewPosition =
        CurrentPosition - FloatGrabOffset

    local ClampedPosition =
        ClampFloatButton(NewPosition)

    FloatButton.Position =
        UDim2.fromOffset(
            math.floor(ClampedPosition.X + 0.5),
            math.floor(ClampedPosition.Y + 0.5)
        )

end

--==============================================================--
-- COMEÇA DRAG
--==============================================================--

FloatButton.InputBegan:Connect(function(Input)

    local InputType =
        Input.UserInputType

    if InputType ~= Enum.UserInputType.MouseButton1
        and InputType ~= Enum.UserInputType.Touch then
        return
    end

    ClearFloatDragConnections()

    DraggingFloat = false

    FloatDragInput = Input

    FloatDragStart =
        Vector2.new(
            Input.Position.X,
            Input.Position.Y
        )

    local AbsolutePosition =
        FloatButton.AbsolutePosition

    FloatStartPosition =
        Vector2.new(
            AbsolutePosition.X,
            AbsolutePosition.Y
        )

    FloatGrabOffset =
        FloatDragStart - FloatStartPosition

    if InputType == Enum.UserInputType.MouseButton1 then

        FloatMouseChangedConnection =
            UserInputService.InputChanged:Connect(function(Change)

                if FloatDragInput ~= Input then
                    return
                end

                if Change.UserInputType
                    ~= Enum.UserInputType.MouseMovement then
                    return
                end

                UpdateFloatPosition(
                    Vector2.new(
                        Change.Position.X,
                        Change.Position.Y
                    )
                )

            end)

    elseif InputType == Enum.UserInputType.Touch then

        FloatTouchMovedConnection =
            UserInputService.TouchMoved:Connect(function(Touch)

                if FloatDragInput ~= Touch then
                    return
                end

                UpdateFloatPosition(
                    Vector2.new(
                        Touch.Position.X,
                        Touch.Position.Y
                    )
                )

            end)

    end

    FloatInputEndedConnection =
        UserInputService.InputEnded:Connect(function(EndedInput)

            if EndedInput ~= FloatDragInput then
                return
            end

            StopFloatDrag()

        end)

end)

