    if not ESPTracerAtivo then
        for p, line in pairs(TracersESP) do
            if line then line.Visible = false end
        end
        return
    end

    local Cam = Workspace.CurrentCamera
    if not Cam then return end

    for _, p in ipairs(Players:GetPlayers()) do
