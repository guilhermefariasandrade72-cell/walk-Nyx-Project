-- 🔍 DETECÇÃO DE CARGOS VIA DADOS DO ESP (Incluindo você mesmo)
-- ==================================
local function getPlayerByRole(roleName)
    if not DadosCargos then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        local info = DadosCargos[player.Name]
        if info and not info.Killed and not info.Dead then
            if info.Role == roleName then
                return player
            end
        end
    end
    return nil
end


