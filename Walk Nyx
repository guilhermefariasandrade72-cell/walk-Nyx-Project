                    Button,

                    TweenInfo.new(
                        0.12
                    ),

                    {
                        BackgroundTransparency =
                            1
                    }
                ):Play()
            end
        end
    )
end

--==============================================================--
-- SIDEBAR EXPAND
--==============================================================--

local function SetSidebarExpanded(
    State
)

    SidebarExpanded =
        State

    local Width =
        State
        and 155
        or 66

    local ContentX =
        State
        and 164
        or 75

    local ContentWidth =
        State
        and -175
        or -86

    TweenService:Create(
        Sidebar,

        TweenInfo.new(
            0.25,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        ),

        {
            Size =
                UDim2.new(
                    0,
                    Width,
                    1,
                    0
                )
        }
    ):Play()

    TweenService:Create(
        Content,

        TweenInfo.new(
            0.25,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        ),

        {
            Position =
                UDim2.fromOffset(
                    ContentX,
                    6
                ),

            Size =
                UDim2.new(
                    1,
                    ContentWidth,
                    1,
                    -12
                )
        }
    ):Play()

    for _, Button
        in ipairs(TabButtons) do

        local NameLabel =
            Button:FindFirstChild(
                "Name"
            )

        if NameLabel then

            TweenService:Create(
                NameLabel,

                TweenInfo.new(
                    0.18
                ),

                {
                    TextTransparency =
                        State
                        and 0
                        or 1
                }
            ):Play()
        end
    end
end

