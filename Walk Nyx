Header.InputBegan:Connect(function(Input)

    if Input.UserInputType ~= Enum.UserInputType.MouseButton1
        and Input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    DraggingWindow = true

    local StartPosition = Input.Position
    local StartWindowPosition = Main.Position

    TweenService:Create(
        Main,
        TweenInfo.new(
            0.18,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Size = UDim2.fromOffset(
                math.floor(CurrentWidth * 1.03),
                math.floor(CurrentHeight * 1.03)
            )
        }
    ):Play()

    local Changed
    local Ended

    Changed = UserInputService.InputChanged:Connect(function(Change)

        if not DraggingWindow then
            return
        end

        if Change.UserInputType == Enum.UserInputType.MouseMovement
            or Change.UserInputType == Enum.UserInputType.Touch then

            local Delta =
                Change.Position - StartPosition

            local ViewportSize =
                workspace.CurrentCamera.ViewportSize

            local RawX =
                StartWindowPosition.X.Offset
                + Delta.X

            local RawY =
                StartWindowPosition.Y.Offset
                + Delta.Y

            local HalfW =
                (CurrentWidth * 1.03) / 2

            local HalfH =
                (CurrentHeight * 1.03) / 2

            local MinX =
                HalfW
                - (ViewportSize.X * 0.5)

            local MaxX =
                (ViewportSize.X * 0.5)
                - HalfW

            local MinY =
                HalfH
                - (ViewportSize.Y * 0.5)

            local MaxY =
                (ViewportSize.Y * 0.5)
                - HalfH

            local ClampedX =
                math.clamp(
                    RawX,
                    MinX,
                    MaxX
                )

            local ClampedY =
                math.clamp(
                    RawY,
                    MinY,
                    MaxY
                )

            Main.Position =
                UDim2.new(
                    0.5,
                    ClampedX,
                    0.5,
                    ClampedY
                )

        end

    end)

    Ended = UserInputService.InputEnded:Connect(function(EndedInput)

        if EndedInput.UserInputType == Enum.UserInputType.MouseButton1
            or EndedInput.UserInputType == Enum.UserInputType.Touch then

            DraggingWindow = false

            TweenService:Create(
                Main,
                TweenInfo.new(
                    0.2,
                    Enum.EasingStyle.Back,
                    Enum.EasingDirection.Out
                ),
                {
                    Size = UDim2.fromOffset(
                        CurrentWidth,
                        CurrentHeight
                    )
                }
            ):Play()

            if Changed then
                Changed:Disconnect()
            end

            if Ended then
                Ended:Disconnect()
            end

        end

    end)

end)

