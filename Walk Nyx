    local function refreshPlayerList()
        local existingPlayers = {}
        
        -- Mapeia os botões que já existem
        for _, child in ipairs(PlayerListFrame:GetChildren()) do
            if child:IsA("TextButton") then
                local playerName = child.Name:gsub("PlayerBtn_", "")
                existingPlayers[playerName] = child
            end
        end

        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                count = count + 1
                local btnName = "PlayerBtn_"..p.Name
                local PlayerBtn = existingPlayers[p.Name]

                if not PlayerBtn then
                    -- Cria o botão apenas se ele ainda não estiver na lista
                    PlayerBtn = Instance.new("TextButton")
                    PlayerBtn.Name = btnName
                    PlayerBtn.Size = UDim2.new(1, -4, 0, 28)
                    PlayerBtn.BorderSizePixel = 0
                    PlayerBtn.Text = ""
