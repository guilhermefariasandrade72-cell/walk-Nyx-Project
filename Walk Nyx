InvisivelToggle.Activated:Connect(function()
    local Ligado = (InvisivelButtonGui ~= nil)
    
    if not Ligado then
        CreateInvisivelButton()
        Ligado = true
    else
        RemoveInvisivelButton()
        Ligado = false
    end

    local targetBg = Ligado and Color3.fromRGB(225, 40, 56) or Color3.fromRGB(11, 12, 16)
    local targetStroke = Ligado and Color3.fromRGB(255, 65, 80) or Color3.fromRGB(39, 40, 48)
    local targetTrans = Ligado and 0 or 1

    TweenService:Create(InvisivelToggle, TweenInfo.new(0.2), {BackgroundColor3 = targetBg}):Play()
    TweenService:Create(InvisivelBtnStroke, TweenInfo.new(0.2), {Color = targetStroke}):Play()
    TweenService:Create(InvisivelCheck, TweenInfo.new(0.2), {TextTransparency = targetTrans}):Play()
end)

